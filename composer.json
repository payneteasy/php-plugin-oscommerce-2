{
    "name": "payneteasy/php-plugin-oscommerce-2",
    "description": "Plugin for OsCommerce 2 for payment by PaynetEasy.",
    "type": "library",
    "keywords":
    [
        "payment",
        "payneteasy",
        "oscommerce"
    ],
    "homepage": "http://payneteasy.com/",
    "license": "MIT",
    "authors":
    [
        {
            "name": "Artem Ponomarenko",
            "email": "imenem@inbox.ru",
            "role": "developer"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories":
    [
        {
            "type": "vcs",
            "url":  "https://github.com/payneteasy/php-library-payneteasy-api"
        }
    ],
    "require":
    {
        "php":                                      ">=7.1.0",
        "payneteasy/php-library-payneteasy-api":    "^1.1"
    },
    "archive":
    {
        "exclude":
        [
            "!/vendor",
            "doc",
            "example",
            "test",
            "composer.*",
            "LICENSE",
            "README.md"
        ]
    },
    "extra":
    {
        "branch-alias":
        {
            "dev-master": "1.1.x-dev"
        }
    }
}
